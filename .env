#
# Enviromental values for Makefile and for docker-compose.yml
#

# Docker Compose project name
COMPOSE_PROJECT_NAME=helfi-rekry
PROJECT_NAME=rekry

# Azure Blob storage location of the database dump used by 'make fresh'
AZURE_DUMP_CONTAINER=hki-database-blob-helfi-rekry-test

# Stage file proxy origin url and folder
STAGE_FILE_PROXY_ORIGIN=https://stplattaprod.blob.core.windows.net
STAGE_FILE_PROXY_ORIGIN_DIR=helfirekryprod

# Local hostname
DRUPAL_HOSTNAME=helfi-rekry.docker.so

COMPOSE_PROFILES=search

# Public webroot
DRUPAL_WEBROOT=public

# Client ID for Helbit integration
HELBIT_CLIENT_ID=

# URL for Elasticsearch (for job search)
ELASTIC_PROXY_URL=https://elastic-proxy-helfi-rekry.docker.so

# Hakuvahti URL
HAKUVAHTI_URL=http://helfi-rekry.docker.so:3000
